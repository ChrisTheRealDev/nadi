{
  "name": "nadi-music-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "node scripts/build-demo.mjs",
    "demo": "npm run build && npm run build:server && npm run start:built",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:built": "node .nadi-server/server.mjs",
    "test:browser:studio": "node scripts/studio-smoke-v019.cjs",
    "test:browser:midi": "node scripts/external-midi-smoke-v019.cjs",
    "test:browser:tutor": "node scripts/tutor-handoff-v019.cjs",
    "test:browser:visual": "node scripts/visual-smoke-v019.cjs",
    "test:browser:score": "node scripts/score-progress-v020.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "opensheetmusicdisplay": "^2.1.3",
    "react": "latest",
    "react-dom": "latest",
    "tone": "15.1.22",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "playwright": "1.65.1",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "rolldown": "1.2.19"
  }
}
